{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Soturine/echora/schemas/sensing-result.schema.json",
  "title": "Echora Sensing Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capability",
    "value",
    "confidence",
    "source_mode",
    "evidence_kind",
    "quality_flags",
    "sensor_ids",
    "observed_at",
    "fresh_until"
  ],
  "properties": {
    "capability": {
      "type": "string",
      "enum": [
        "presence",
        "motion",
        "respiration_bpm",
        "heart_rate_bpm",
        "occupancy_count",
        "position",
        "pose"
      ]
    },
    "value": {},
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "source_mode": {
      "type": "string",
      "enum": ["LIVE", "REPLAY", "SIMULATED"]
    },
    "evidence_kind": {
      "type": "string",
      "enum": [
        "MEASURED",
        "CALIBRATED",
        "RECONSTRUCTED",
        "INFERRED",
        "GENERATED",
        "SIMULATED",
        "REFERENCE"
      ]
    },
    "quality_flags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "run_id": { "type": ["string", "null"] },
    "capture_id": { "type": ["string", "null"] },
    "calibration_id": { "type": ["string", "null"] },
    "model_id": { "type": ["string", "null"] },
    "sensor_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "fresh_until": { "type": "string", "format": "date-time" },
    "abstention": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["reason"],
          "properties": {
            "reason": {
              "type": "string",
              "enum": [
                "INSUFFICIENT_SNR",
                "CALIBRATION_MISSING",
                "CALIBRATION_STALE",
                "SOURCE_STALE",
                "GEOMETRY_INSUFFICIENT",
                "MODEL_UNAVAILABLE",
                "MODEL_INCOMPATIBLE",
                "DATA_GAP",
                "UNSUPPORTED"
              ]
            }
          }
        }
      ]
    }
  }
}
